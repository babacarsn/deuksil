# =============================================================================
# DEUKSIL — variables d'environnement (MODÈLE, sans aucune valeur réelle)
# Copier en « .env » (ignoré par Git) pour les outils en ligne de commande.
# Le NAVIGATEUR ne lit aucune de ces variables : sa configuration publique est
# dans js/00-config.js (URL du projet + clé « anon » / « publishable », publiques
# par conception et protégées par la RLS).
# =============================================================================

# --- Projet Supabase (Dashboard → Project Settings → API) ---------------------
SUPABASE_URL=https://<ref-du-projet>.supabase.co
# Clé publique (anon / publishable) : peut figurer dans js/00-config.js
SUPABASE_ANON_KEY=<cle-anon-publique>

# --- SECRETS SERVEUR : jamais dans le navigateur, jamais dans Git ---------------
# Clé service_role (contourne la RLS). Utilisée UNIQUEMENT par :
#   * la fonction Edge « gerer-acces » (fournie automatiquement par Supabase) ;
#   * les outils d'administration locaux (supabase/outils/*.js) sur une base de TEST.
SUPABASE_SERVICE_ROLE_KEY=<ne-pas-renseigner-ici-en-production>
# Connexion directe à la base (migrations, outils). Mot de passe : Dashboard → Database.
DATABASE_URL=postgresql://postgres:<mot-de-passe>@db.<ref-du-projet>.supabase.co:5432/postgres

# --- Fonction Edge « gerer-acces » (secrets : supabase secrets set …) ------------
# Origines autorisées (CORS), séparées par des virgules — l'adresse publique du site.
DEUKSIL_ORIGINES=https://www.exemple.sn

# --- Fonction Edge « assistant-ia » (secrets : supabase secrets set …) -----------
# Clé de l'API Gemini (Google AI Studio). SECRET : jamais dans js/ ni dans Git.
GEMINI_API_KEY=<cle-gemini>
# Modèle (facultatif, défaut : gemini-flash-latest).
GEMINI_MODEL=gemini-flash-latest
# Questions de gestion (factures, devis, contrats, loyers…) : « oui » SEULEMENT avec l'offre
# PAYANTE de l'API Gemini (facturation activée). L'offre gratuite interdit d'y envoyer des
# données personnelles ou confidentielles. Absent ou autre valeur : questions générales seulement.
GEMINI_PAYANT=non

# --- Connexion Google (Dashboard → Authentication → Providers → Google) ---------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<identifiant-client-oauth>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<secret-client-oauth>

# --- Envoi des e-mails d'authentification (SMTP de votre fournisseur) -----------
SMTP_HOST=<serveur-smtp>
SMTP_PORT=587
SMTP_USER=<utilisateur-smtp>
SMTP_PASS=<mot-de-passe-smtp>
SMTP_ADMIN_EMAIL=noreply@exemple.sn

# --- Tests (base de TEST uniquement) ---------------------------------------------
# Adresse de l'application servie contre la base de test
APP_URL=http://127.0.0.1:54321/
# Mot de passe commun des comptes du jeu de test (choisi localement)
MOT_DE_PASSE_TEST=<mot-de-passe-de-test>
# Autoriser les tests d'écriture sur un projet Supabase distant DÉDIÉ AUX TESTS
DEUKSIL_TEST_AUTORISE=0
