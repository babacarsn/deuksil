API_EXTERNAL_URL=http://127.0.0.1:54321/auth/v1
GOTRUE_API_HOST=127.0.0.1
PORT=9999
GOTRUE_SITE_URL=http://127.0.0.1:54321
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:54321/**
GOTRUE_JWT_SECRET=${JWT_SECRET}
