# Réplique locale de test — chemins (copier en « env » et adapter). Aucun secret de production.
REPLIQUE_DIR=$HOME/deuksil-replique          # données, journaux, fichiers déposés
PG_BIN=/usr/lib/postgresql/16/bin            # PostgreSQL 15+ (binaires serveur)
PG_PORT=54322
AUTH_BIN=$REPLIQUE_DIR/bin/auth              # Supabase Auth (GoTrue) v2.16x+
AUTH_MIGRATIONS=$REPLIQUE_DIR/bin/migrations # migrations fournies avec Supabase Auth
POSTGREST_BIN=$REPLIQUE_DIR/bin/postgrest    # PostgREST 12.x
DENO_BIN=deno                                # Deno 2.x (fonction Edge)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long   # LOCAL uniquement
MOT_DE_PASSE_TEST=Essai-Local-2026           # mot de passe commun des comptes de test
